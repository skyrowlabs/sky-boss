# The tracked SHAPE of the environment. The real .env is untracked and never
# committed — a pre-commit hook refuses any .env* that is not this file.
#
# Every value the application reads must appear here, with a comment saying what
# it is for. A config value that exists only in someone's .env is a value the
# next person's process cannot start without and cannot discover.
#
# tests/test_env_example_parity.py holds both directions: a name declared here
# is read somewhere in the tree, and every SB_* name the source
# reads is declared here. This file used to ship three values nothing read.
#
# A line that is exactly `# secret`, directly above a declaration, marks that
# value as a credential: kept out of this file, supplied by a secrets manager or
# your own .env. Own line, never trailing — Docker --env-file and systemd keep an
# inline comment as part of the value. scripts/env_shape.py is the one reader.
# A name ending _KEY, _TOKEN, _SECRET, _PASSWORD, _CREDENTIALS, _WEBHOOK or
# _WEBHOOK_URL must carry the tag, or be listed in tests/secret_name_allowlist.yaml
# with why it is not one.

# ── CI semantics ────────────────────────────────────────────────────────
# Set to 1 by CI and by `dev test --ci`. Under it, an env-gate skip becomes a
# test failure: CI guarantees the environment, so a skip means the harness broke.
# SB_CI=1

# ── Where run state lives ───────────────────────────────────────────────
# Transcripts, ledgers and per-job memory live under
# ~/.local/state/agent-logs/<slug>/ unless this points elsewhere. Read by
# scripts/paths.py; the test suite points it at a temporary directory.
# SB_STATE_ROOT=

# ── Capture attribution ─────────────────────────────────────────────────
# Set by the job runner for an unattended agent, never by hand: `dev bug`
# and `dev task` read it to file under the job's own cap. See scripts/lanes.py.
# SB_CAPTURE_SOURCE=

# ── Scheduled jobs: dead-man switches ───────────────────────────────────
# One push URL per job. A job pings it on success AND on a legitimate decline —
# an executed-and-declined job must stay distinguishable from a dead cron, or
# every correct decline pages somebody and the pages stop being read.
#
# A job with no monitor behind it is a job that can stop running silently, which
# is the failure mode this whole system exists to remove. tests/test_reporting_jobs.py
# fails if a registered job's variable is missing from this file.
#
# Secret because anyone holding the URL can ping the monitor and mask a dead job.
# secret
HEARTBEAT_REPO_REPORT=
# secret
HEARTBEAT_AGENT_TASK=
# secret
HEARTBEAT_AGENT_FIX=
# secret
HEARTBEAT_DEP_MIGRATE=
# secret
HEARTBEAT_OVERNIGHT=

# ── Scheduled jobs: which agent runs the triage stage ───────────────────
# A full argv template; `{prompt}` is replaced with the whole prompt and the
# argv is executed directly, never through a shell. Unset means Claude Code:
#     claude -p {prompt} --permission-mode acceptEdits
#
# Only that invocation is tested here. Anything else must satisfy the contract
# in scripts/reporting/agent_runner.py — above all, leave the job's artifact or
# a commit behind, because a zero exit that wrote nothing is recorded as failed.
# SB_AGENT_CMD='claude -p {prompt} --permission-mode acceptEdits --output-format json'

# The identity an agent runs as: a name from SEATS in scripts/reporting/jobs.py.
# The generated cron block sets it for scheduled jobs; unset is `personal`, the
# ambient `claude` and `gh` login. Not for .env, which interactive runs read too.
# SB_SEAT=personal

# Set to 1 by `dev report <key> --dry-run`: every job runs its deterministic
# stage, says what its agent would do, and records nothing. Not for .env.
# SB_DRY_RUN=1

# ── sky.boss itself ─────────────────────────────────────────────────────
# The product shares the dev shell's SB_ prefix, so its own names belong here
# too. Nothing loads a .env; these are read straight from the environment.
#
# Operator content — tools.toml, formats.toml, projects.toml. Default ~/.sky-boss.
# SB_HOME=
# What the surface remembers about itself. Default ~/.local/state/sb.
# SB_STATE=
# Set to 1 to re-raise a command's exception instead of folding it into the
# envelope (skyboss/output.py).
# SB_DEBUG=1
